# Node Environment
NODE_ENV=development
PORT=3001
HOST=0.0.0.0

# Client Config
VITE_GAME_SERVER_URL=http://localhost:3001
VITE_MOCK_MODE=true

# Database Config (PostgreSQL)
DATABASE_URL="postgresql://zombie_user:zombie_password@localhost:5432/zombie_db?schema=public"

# Redis Config
REDIS_URL="redis://localhost:6379"

# Security & Secrets
JWT_SECRET="dev-insecure-jwt-secret-replace-in-production"
SESSION_SECRET="dev-insecure-session-secret-replace-in-production"

# Live Integration Flags
MOCK_MODE=true
TIKTOK_ENABLED=false
